# Production Environment Variables for NestJS Backend
# Note: For security, it is highly recommended to enter these keys directly in the Render dashboard 
# under "Environment Variables" rather than committing them in plain text to your repository.

PORT=10000
DATABASE_URL="YOUR_PRODUCTION_DATABASE_URL"

SUPABASE_URL="YOUR_PRODUCTION_SUPABASE_URL"
SUPABASE_KEY="YOUR_PRODUCTION_SUPABASE_KEY"

CLOUDINARY_URL="YOUR_PRODUCTION_CLOUDINARY_URL"
CLOUDINARY_CLOUD_NAME="YOUR_PRODUCTION_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_PRODUCTION_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_PRODUCTION_CLOUDINARY_API_SECRET"
