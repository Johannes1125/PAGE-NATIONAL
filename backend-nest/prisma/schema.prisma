generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model article_submissions {
  id                                           BigInt    @id @default(autoincrement())
  user_id                                      BigInt
  title                                        String    @db.VarChar(255)
  author                                       String    @db.VarChar(255)
  abstract                                     String
  keywords                                     Json      @db.Json
  file_path                                    String    @db.VarChar(255)
  file_name                                    String    @db.VarChar(255)
  status                                       String    @default("pending") @db.VarChar(255)
  reviewer_id                                  BigInt?
  due_date                                     DateTime? @db.Date
  created_at                                   DateTime? @db.Timestamp(0)
  updated_at                                   DateTime? @db.Timestamp(0)
  users_article_submissions_reviewer_idTousers users?    @relation("article_submissions_reviewer_idTousers", fields: [reviewer_id], references: [id], onUpdate: NoAction, map: "article_submissions_reviewer_id_foreign")
  users_article_submissions_user_idTousers     users     @relation("article_submissions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_submissions_user_id_foreign")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model message_attachments {
  id         BigInt    @id @default(autoincrement())
  message_id BigInt
  file_path  String    @db.VarChar(255)
  file_name  String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  messages   messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_attachments_message_id_foreign")
}

model messages {
  id                                BigInt                @id @default(autoincrement())
  conversation_id                   String                @db.VarChar(255)
  sender_id                         BigInt
  receiver_id                       BigInt?
  subject                           String?               @db.VarChar(255)
  text                              String
  status                            String                @default("sent") @db.VarChar(255)
  created_at                        DateTime?             @db.Timestamp(0)
  updated_at                        DateTime?             @db.Timestamp(0)
  message_attachments               message_attachments[]
  users_messages_receiver_idTousers users?                @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], onUpdate: NoAction, map: "messages_receiver_id_foreign")
  users_messages_sender_idTousers   users                 @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_sender_id_foreign")

  @@index([conversation_id], map: "messages_conversation_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model post_attachments {
  id         BigInt    @id @default(autoincrement())
  post_id    BigInt
  file_path  String    @db.VarChar(255)
  file_type  String    @db.VarChar(255)
  file_name  String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "post_attachments_post_id_foreign")
}

model posts {
  id               BigInt             @id @default(autoincrement())
  user_id          BigInt
  title            String             @db.VarChar(255)
  category         String             @db.VarChar(255)
  author           String             @db.VarChar(255)
  excerpt          String?
  content_html     String
  status           String             @default("draft") @db.VarChar(255)
  feedback         String?
  scheduled_at     DateTime?          @db.Timestamp(0)
  published_at     DateTime?          @db.Timestamp(0)
  assigned_members String?            @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  post_attachments post_attachments[]
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "posts_user_id_foreign")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model user_activities {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  action     String    @db.VarChar(255)
  ip_address String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_activities_user_id_foreign")
}

model users {
  id                                                         BigInt                @id @default(autoincrement())
  name                                                       String                @db.VarChar(255)
  email                                                      String                @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at                                          DateTime?             @db.Timestamp(0)
  password                                                   String                @db.VarChar(255)
  role                                                       String                @default("member") @db.VarChar(255)
  university                                                 String?               @db.VarChar(255)
  position                                                   String?               @db.VarChar(255)
  status                                                     String                @default("active") @db.VarChar(255)
  api_token_hashed                                           String?               @db.VarChar(255)
  remember_token                                             String?               @db.VarChar(100)
  created_at                                                 DateTime?             @db.Timestamp(0)
  updated_at                                                 DateTime?             @db.Timestamp(0)
  article_submissions_article_submissions_reviewer_idTousers article_submissions[] @relation("article_submissions_reviewer_idTousers")
  article_submissions_article_submissions_user_idTousers     article_submissions[] @relation("article_submissions_user_idTousers")
  messages_messages_receiver_idTousers                       messages[]            @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers                         messages[]            @relation("messages_sender_idTousers")
  posts                                                      posts[]
  user_activities                                            user_activities[]
  membership_applications                                    MembershipApplication[]

  @@index([api_token_hashed], map: "users_api_token_hashed_index")
}

model about_page_sections {
  id           String    @id @default(uuid()) @db.Uuid
  section_key  String    @unique @db.VarChar(255)
  title        String    @db.VarChar(255)
  content      String    @db.Text
  status       String    @default("draft") @db.VarChar(255) // 'draft' | 'published' | 'archived'
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  published_at DateTime? @db.Timestamp(0)
}

model about_page_officers {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  position   String    @db.VarChar(255)
  chapter    String?   @db.VarChar(255)
  photo_url  String?   @db.VarChar(255)
  term_start String?   @db.VarChar(255)
  term_end   String?   @db.VarChar(255)
  status     String    @default("active") @db.VarChar(255) // 'active' | 'inactive'
  sort_order Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)
}

model about_page_documents {
  id          String    @id @default(uuid()) @db.Uuid
  section_key String    @db.VarChar(255)
  file_name   String    @db.VarChar(255)
  file_url    String    @db.VarChar(255)
  file_type   String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamp(0)
}

model cbl_articles {
  id                  String   @id @default(uuid()) @db.Uuid
  article_number      String   @db.VarChar(255)
  article_name        String   @db.VarChar(255)
  article_description String   @db.Text
  sort_order          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model cbl_governance_documents {
  id                  String   @id @default(uuid()) @db.Uuid
  title               String   @db.VarChar(255)
  general_description String   @db.Text
  file_name           String?  @db.VarChar(255)
  file_url            String?  @db.VarChar(255)
  file_size           Int?
  uploaded_by         String?  @db.VarChar(255)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(0)
}


model historical_records {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  yearStart   Int
  programType String   @db.VarChar(50)
  description String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model page_logos {
  id              Int       @id @default(autoincrement())
  sequenceNumber  String    @unique
  title           String    @db.VarChar(255)
  description     String    @db.Text
  imageUrl        String    @db.VarChar(255)
  imagePublicId   String?   @db.VarChar(255)
  createdAt       DateTime  @default(now()) @db.Timestamp(0)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamp(0)
}

model NationalOfficer {
  id               String   @id @default(cuid())
  memberName       String
  positionCategory String
  role             String
  description      String?
  imageUrl         String?
  sortOrder        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SecRegistration {
  id                  String    @id @default(cuid())
  registrationName    String?
  registrationNumber  String?
  dateOfIncorporation DateTime?
  exemptionCategory   String?
  imageUrl            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BirCertification {
  id                  String    @id @default(uuid())
  registrationName    String?
  tinNumber           String?
  certificationNumber String?
  exemptionCategory   String?
  dateOfIssuance      DateTime?
  imageUrl            String?
  receiptUrl          String?
  imagePublicId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("bir_certifications")
}

// ─── Chapter Management ───────────────────────────────────────────────────────

model Chapter {
  id                String                @id @default(cuid())
  title             String                @db.VarChar(255)
  slug              String                @unique @db.VarChar(255)
  short_description String                @db.Text
  island_group      String                @db.VarChar(50)  // Luzon | Visayas | Mindanao
  region            String                @db.VarChar(100)
  overview          String                @db.Text
  mission           String?               @db.Text
  vision            String?               @db.Text
  status            String                @default("draft") @db.VarChar(20) // draft | published | archived
  created_by        BigInt?
  updated_by        BigInt?
  created_at        DateTime              @default(now()) @db.Timestamp(0)
  updated_at        DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  published_at      DateTime?             @db.Timestamp(0)

  images            ChapterImage[]
  documents         ChapterDocument[]
  officers          ChapterOfficer[]
  activities        ChapterActivity[]
  announcements     ChapterAnnouncement[]

  @@index([status])
  @@index([island_group])
  @@index([slug])
  @@map("chapters")
}

model ChapterImage {
  id         String   @id @default(cuid())
  chapter_id String
  file_url   String   @db.VarChar(500)
  file_name  String   @db.VarChar(255)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(0)

  chapter    Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_images")
}

model ChapterDocument {
  id         String   @id @default(cuid())
  chapter_id String
  file_url   String   @db.VarChar(500)
  file_name  String   @db.VarChar(255)
  file_type  String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(0)

  chapter    Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_documents")
}

model ChapterOfficer {
  id            String   @id @default(cuid())
  chapter_id    String
  name          String   @db.VarChar(255)
  category_type String   @db.VarChar(100)
  year_joined   Int
  year_end      Int?
  sort_order    Int      @default(0)
  image_url     String?  @db.VarChar(500)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(0)

  chapter       Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_officers")
}

model ChapterActivity {
  id          String   @id @default(cuid())
  chapter_id  String
  title       String   @db.VarChar(255)
  description String   @db.Text
  date        DateTime @db.Date
  image_url   String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  chapter     Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_activities")
}

model ChapterAnnouncement {
  id         String   @id @default(cuid())
  chapter_id String
  title      String   @db.VarChar(255)
  content    String   @db.Text
  date       DateTime @db.Date
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  chapter    Chapter  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@map("chapter_announcements")
}

model Convention {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  convention_number String    @db.VarChar(255)
  title             String    @db.VarChar(255)
  description       String    @db.Text
  location          String    @db.VarChar(255)
  start_date        DateTime  @db.Date
  end_date          DateTime  @db.Date
  status            String    @default("draft") @db.VarChar(50)
  created_by        BigInt?
  updated_by        BigInt?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  published_at      DateTime? @db.Timestamptz(6)

  attachments ConventionAttachment[]
  schedules   ConventionSchedule[]
  speakers    ConventionSpeaker[]

  @@map("conventions")
}

model ConventionAttachment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  convention_id String   @db.Uuid
  file_url      String   @db.Text
  file_name     String   @db.VarChar(255)
  file_type     String   @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  convention Convention @relation(fields: [convention_id], references: [id], onDelete: Cascade)

  @@index([convention_id])
  @@map("convention_attachments")
}

model ConventionSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  convention_id String   @db.Uuid
  schedule_date DateTime @db.Date
  title         String   @db.VarChar(255)
  event_type    String   @db.VarChar(255)
  start_time    String?  @db.VarChar(50)
  end_time      String?  @db.VarChar(50)
  location      String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  convention Convention @relation(fields: [convention_id], references: [id], onDelete: Cascade)

  @@index([convention_id])
  @@map("convention_schedules")
}

model ConventionSpeaker {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  convention_id      String   @db.Uuid
  name               String   @db.VarChar(255)
  role_position      String   @db.VarChar(255)
  institution        String   @db.VarChar(255)
  presentation_topic String   @db.VarChar(255)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  convention Convention @relation(fields: [convention_id], references: [id], onDelete: Cascade)

  @@index([convention_id])
  @@map("convention_speakers")
}

enum MembershipType {
  LIFE
  REGULAR
  ASSOCIATE
  INSTITUTIONAL
}

enum MembershipApplicationStatus {
  draft
  submitted
  under_review
  approved
  rejected
}

enum MembershipDocumentType {
  registrar_certification
  id_card_photo
  proof_of_payment
  transcript
  active_member_id
  degree_proof
  current_enrollment_proof
  photo_1x1
  other
}

model MembershipApplication {
  id                String                      @id @default(uuid()) @db.Uuid
  membershipType    MembershipType
  status            MembershipApplicationStatus @default(draft)
  currentStep       Int                         @default(1)
  profileData       Json?
  educationJobData  Json?
  experienceData    Json?
  referencesData    Json?
  feeAmount         Decimal                     @db.Decimal(10, 2)
  applicantId       BigInt?
  applicant         users?                      @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  documents         MembershipApplicationDocument[]
  createdAt         DateTime                    @default(now()) @db.Timestamp(0)
  updatedAt         DateTime                    @default(now()) @updatedAt @db.Timestamp(0)
  submittedAt       DateTime?                   @db.Timestamp(0)
  rejectionReason   String?                     @db.Text

  @@map("membership_applications")
}

model MembershipApplicationDocument {
  id              String                 @id @default(uuid()) @db.Uuid
  applicationId   String                 @db.Uuid
  documentType    MembershipDocumentType
  fileUrl         String                 @db.VarChar(500)
  fileName        String                 @db.VarChar(255)
  filePublicId    String?                @db.VarChar(255)
  uploadedAt      DateTime               @default(now()) @db.Timestamp(0)
  application     MembershipApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("membership_application_documents")
}

model Notification {
  id        String   @id @db.VarChar(255)
  type      String   @db.VarChar(50)
  sourceId  String   @db.VarChar(255)
  title     String   @db.VarChar(255)
  body      String   @db.Text
  isRead    Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@index([type, sourceId])
  @@index([isDeleted, isRead])
  @@map("notifications")
}
